    "question": "FAB12 공정별 WIP 지난주와 이번주 비교",
    "sql": "WITH observations AS (SELECT interval_end, area, SUM(wip_lots) AS wip_lots, MIN(EXTRACT(EPOCH FROM (interval_end - interval_start)) / 60.0) AS observation_minutes_min, MAX(EXTRACT(EPOCH FROM (interval_end - interval_start)) / 60.0) AS observation_minutes_max FROM fab12.live_process_snapshots_fab12 WHERE fab_id = 'fab12' AND ((interval_end >= TIMESTAMPTZ '2026-08-31 00:00:00+09:00' AND interval_end < TIMESTAMPTZ '2026-09-07 00:00:00+09:00') OR (interval_end >= TIMESTAMPTZ '2026-09-07 00:00:00+09:00' AND interval_end < TIMESTAMPTZ '2026-09-13 00:00:00+09:00')) GROUP BY interval_end, area) SELECT CASE WHEN interval_end >= TIMESTAMPTZ '2026-08-31 00:00:00+09:00' AND interval_end < TIMESTAMPTZ '2026-09-07 00:00:00+09:00' THEN '2026-08-31 ~ 2026-09-06' WHEN interval_end >= TIMESTAMPTZ '2026-09-07 00:00:00+09:00' AND interval_end < TIMESTAMPTZ '2026-09-13 00:00:00+09:00' THEN '2026-09-07 ~ 2026-09-12' END AS comparison_period, area, AVG(wip_lots) AS wip_lots, COUNT(*) AS observation_count, MIN(interval_end) AS first_observed_at, MAX(interval_end) AS last_observed_at, MIN(observation_minutes_min) AS observation_minutes_min, MAX(observation_minutes_max) AS observation_minutes_max FROM observations GROUP BY CASE WHEN interval_end >= TIMESTAMPTZ '2026-08-31 00:00:00+09:00' AND interval_end < TIMESTAMPTZ '2026-09-07 00:00:00+09:00' THEN '2026-08-31 ~ 2026-09-06' WHEN interval_end >= TIMESTAMPTZ '2026-09-07 00:00:00+09:00' AND interval_end < TIMESTAMPTZ '2026-09-13 00:00:00+09:00' THEN '2026-09-07 ~ 2026-09-12' END, area ORDER BY comparison_period, area",
