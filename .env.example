# Chat agents call the configured model API. Set your own credential locally.
OPENAI_ENDPOINT=https://skax.ai-talentlab.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_API_VERSION=2024-12-01-preview
STREAM_TIMEOUT_SECONDS=120

# Optional database connection for Text2SQL; document-only RAG does not need it.
POSTGRES_DSN=
MYSQL_DSN=
DB_ALLOWED_SCHEMAS=fab10,fab11,fab12,fab13

# Default retrieval uses the committed corpus and local BM25.
# Planner/Supervisor/answer generation still call the model API.
RAG_RERANKER=feature
RAG_CANDIDATE_K=30
RAG_RERANK_LIMIT=12
RAG_CONTEXT_CHARS=14000

# Enable these only after building an index; see docs/rag_search_runbook.md.
# VECTOR_DB_URL=http://localhost:19530
# VECTOR_DB_COLLECTION=master_pjt_rag_v2
# RAG_INDEX_MANIFEST_PATH=apps/assistant/output/rag/index_manifest.json
# RAG_RERANKER=llm
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_REVISION=text-embedding-3-large.v1
EMBEDDING_DIMENSION=3072
